---
import { Image } from 'astro:assets';
import equipFront from '../assets/fotos/content/1_club/equip1.png';
import equipBack from '../assets/fotos/content/1_club/equip2.png';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const kits = [
  { image: equipFront, alt: 'Equipación frontal C.C. Tospelat', caption: t('equipacion.training') },
  { image: equipBack, alt: 'Equipación trasera C.C. Tospelat', caption: t('equipacion.competition') },
];
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-12 mb-16">
  {kits.map(({ image, alt, caption }) => (
    <div class="relative overflow-hidden rounded-2xl">
      <div class="aspect-square">
        <Image src={image} alt={alt} widths={[400, 800]} sizes="(min-width: 768px) 420px, 100vw" class="w-full h-full object-contain p-4" />
      </div>
      <div class="absolute inset-0 flex items-end p-6">
        <p class="text-black font-bold text-lg">{caption}</p>
      </div>
    </div>
  ))}
</div>
