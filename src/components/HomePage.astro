---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import HeroPresentation from './HeroPresentation.astro';
import ClubSection from './ClubSection.astro';
import SponsorsCarousel from './SponsorsCarousel.astro';
import EntrenamientoSection from './entrenamiento/EntrenamientoSection.astro';
import NewsSection from './NewsSection.astro';
import CalendarSection from './CalendarSection.astro';
import Footer from './Footer.astro';

type Props = { description?: string };
---

<Layout title="C.C. Tospelat Moncada" description={Astro.props.description}>
  <Header />
  <main>
    <HeroPresentation />
    <ClubSection />
    <SponsorsCarousel />
    <EntrenamientoSection />
    <NewsSection />
    <CalendarSection />
  </main>
  <Footer />
</Layout>
