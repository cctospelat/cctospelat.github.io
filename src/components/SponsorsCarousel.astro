---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import ContentImage from './ui/ContentImage.astro';
import SectionHeading from './ui/SectionHeading.astro';
import agreementPhoto from '../assets/fotos/content/2_colaboradores/sponsor1.webp';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);

const entry = await getEntry('colaboradores', `${lang}/2_colaboradores`);
if (!entry) {
  throw new Error(`Missing src/content/${lang}/2_colaboradores/index.md`);
}

const { title, category, sponsors } = entry.data;
const { Content } = await render(entry);
---

<section id="patrocinadores" class="py-24 bg-slate-50 relative">
  <div class="max-w-6xl mx-auto px-5 sm:px-6 lg:px-8">
    <SectionHeading label={category} title={title} class="mb-14" />
  </div>

  <div class="relative w-full overflow-hidden">
    {/* Fade masks */}
    <div class="absolute inset-y-0 left-0 w-20 bg-gradient-to-r from-slate-50 to-transparent z-10"></div>
    <div class="absolute inset-y-0 right-0 w-20 bg-gradient-to-l from-slate-50 to-transparent z-10"></div>

    <div class="marquee-track">
      {/* The list is rendered twice so the -50% translation loops seamlessly */}
      {[false, true].map((duplicate) => (
        <div class="flex items-center shrink-0" aria-hidden={duplicate ? 'true' : undefined}>
          {sponsors.map((sponsor) => (
            <div class="mx-12 sm:mx-20 flex-shrink-0">
              <ContentImage src={sponsor.logo} alt={duplicate ? '' : sponsor.name} height={96} class="block h-20 sm:h-24 w-auto object-contain" loading="lazy" />
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>

  <div class="club-prose max-w-2xl mx-auto px-5 sm:px-6 lg:px-8 mt-14 text-center">
    <Content />
  </div>

  <div class="max-w-sm mx-auto px-5 sm:px-6 lg:px-8 mt-12">
    <div class="rounded-2xl overflow-hidden shadow-lg">
      <Image src={agreementPhoto} alt="Acuerdo de colaboración con Clínica Balaguer" width={384} densities={[1, 2]} class="w-full object-cover" />
    </div>
  </div>
</section>

<style>
  @keyframes marquee {
    to { transform: translate3d(-50%, 0, 0); }
  }

  .marquee-track {
    display: flex;
    align-items: center;
    width: max-content;
    padding: 1rem 0;
    animation: marquee 35s linear infinite;
  }

  @media (max-width: 640px) {
    .marquee-track {
      animation-duration: 20s;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
      width: 100%;
      flex-wrap: wrap;
      justify-content: center;
      gap: 2rem;
    }
    .marquee-track > [aria-hidden] {
      display: none;
    }
  }
</style>
