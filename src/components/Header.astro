---
import { Image } from 'astro:assets';
import SocialIcons from './header/SocialIcons.astro';
import LanguageSelector from './header/LanguageSelector.astro';
import DesktopNav from './header/DesktopNav.astro';
import MobileMenu from './header/MobileMenu.astro';
import logo from '../assets/logos/logo1.png';
import mainSponsor from '../assets/fotos/content/2_colaboradores/sponsors/sponsor_1.png';
import { getHomeUrl, getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<header id="site-header" class="bg-white/90 backdrop-blur-md sticky top-0 z-50 border-b border-slate-200 shadow-sm">
  {/* Social Media Top Bar */}
  <div class="bg-slate-950 text-white py-2">
    <div class="max-w-[1172px] mx-auto px-5 sm:px-6 lg:px-8 flex justify-end items-center space-x-8">
      <SocialIcons />
      <LanguageSelector />
    </div>
  </div>

  <div class="max-w-[1172px] mx-auto px-5 sm:px-6 lg:px-8">
    <div class="header-nav flex justify-between h-24 sm:h-40 items-center transition-all duration-300 relative">
      <div class="flex-shrink-0 flex items-center gap-4 sm:gap-6">
        <a href={getHomeUrl(lang)} class="flex items-center">
          <Image src={logo} alt={t('header.logo_alt')} height={160} densities={[1, 2]} loading="eager" fetchpriority="high" class="header-logo h-24 sm:h-40 w-auto transition-all duration-300 hover:scale-110" />
        </a>
        <Image src={mainSponsor} alt="Patrocinador principal" height={64} densities={[1, 2]} loading="eager" class="header-sponsor h-10 sm:h-16 w-auto transition-all duration-300 opacity-80 hover:opacity-100" />
      </div>

      <DesktopNav />
      <MobileMenu />
    </div>
  </div>
</header>

<style>
  /* Compact header once the page is scrolled */
  .scrolled .header-nav,
  .scrolled .header-logo {
    height: 4rem;
  }
  .scrolled .header-sponsor {
    height: 2rem;
  }

  @media (min-width: 640px) {
    .scrolled .header-nav,
    .scrolled .header-logo {
      height: 5rem;
    }
    .scrolled .header-sponsor {
      height: 2.5rem;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header')!;

  // Keep anchor jumps clear of the sticky header, whatever its current height.
  new ResizeObserver(() => {
    document.documentElement.style.scrollPaddingTop = `${header.offsetHeight}px`;
  }).observe(header);

  let ticking = false;
  window.addEventListener(
    'scroll',
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        header.classList.toggle('scrolled', window.scrollY > 50);
        ticking = false;
      });
    },
    { passive: true },
  );
</script>
