---
import { SECTIONS } from '../../data/site';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const t = useTranslations(getLangFromUrl(Astro.url));
---

<nav class="hidden md:flex space-x-8">
  {SECTIONS.map(({ id, label }) => (
    <a href={`#${id}`} class="relative text-sm font-display font-bold uppercase tracking-widest text-slate-600 hover:text-red-600 transition-colors duration-200 group py-1">
      {t(label)}
      <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-red-500 group-hover:w-full transition-all duration-300 rounded-full"></span>
    </a>
  ))}
</nav>
