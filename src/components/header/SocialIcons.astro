---
import { SOCIAL_LINKS } from '../../data/site';
---

<div class="flex space-x-5 items-center">
  {SOCIAL_LINKS.map(({ name, url, icon }) => (
    <a href={url} target="_blank" rel="noopener noreferrer" aria-label={name} class="text-white hover:text-red-500 transition-colors duration-200">
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d={icon} /></svg>
    </a>
  ))}
</div>
