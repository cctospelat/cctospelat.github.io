---
import { languages, type Lang } from '../../i18n/ui';
import { getHomeUrl, getLangFromUrl } from '../../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
---

<div class="flex space-x-3 items-center border-l border-slate-800 pl-8">
  {(Object.entries(languages) as [Lang, (typeof languages)[Lang]][]).map(([lang, { name }]) => (
    <a
      href={getHomeUrl(lang)}
      title={name}
      lang={lang}
      class:list={[
        'group relative w-6 h-4 overflow-hidden rounded-sm border transition-all',
        lang === currentLang ? 'border-red-500 ring-1 ring-red-500' : 'border-slate-800 hover:border-slate-600',
      ]}
    >
      <img src={`/logos/flags/${lang}.svg`} alt={name} width="24" height="16" class="w-full h-full object-cover grayscale-[0.2] group-hover:grayscale-0 transition-all" />
    </a>
  ))}
</div>
