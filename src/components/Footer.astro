---
import { Image } from 'astro:assets';
import logo from '../assets/logos/logo3.png';
import { SECTIONS, SOCIAL_LINKS } from '../data/site';
import { getHomeUrl, getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const footerSections = SECTIONS.filter(({ id }) => ['club', 'noticias', 'calendario'].includes(id));
---

<footer class="bg-slate-950 text-slate-300 border-t-4 border-red-500">
  <div class="max-w-6xl mx-auto px-5 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div>
        <a href={getHomeUrl(lang)} class="flex items-center mb-4">
          <Image src={logo} alt={t('header.logo_alt')} height={48} densities={[1, 2]} class="h-14 w-auto bg-white rounded-md px-2 py-1" />
        </a>
        <p class="text-slate-400 text-sm leading-relaxed max-w-xs">
          {t('footer.description')}
        </p>
      </div>

      <div>
        <h3 class="font-display font-black uppercase tracking-wide text-white text-lg mb-4">{t('footer.links')}</h3>
        <ul class="space-y-2 text-sm">
          {footerSections.map(({ id, label }) => (
            <li><a href={`#${id}`} class="hover:text-red-500 transition-colors">{t(label)}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="font-display font-black uppercase tracking-wide text-white text-lg mb-4">{t('footer.follow')}</h3>
        <p class="text-sm text-slate-400 mb-4">{t('footer.social_text')}</p>
        <div class="flex space-x-4">
          {SOCIAL_LINKS.map(({ name, url, icon }) => (
            <a href={url} target="_blank" rel="noopener noreferrer" aria-label={name} class="w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center hover:bg-red-500 hover:text-white transition-colors">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d={icon} /></svg>
            </a>
          ))}
        </div>
      </div>
    </div>
    <div class="border-t border-slate-800 mt-12 pt-8 flex flex-col md:flex-row justify-between items-center text-sm text-slate-500 gap-2">
      <p>&copy; {new Date().getFullYear()} C.C. Tospelat. {t('footer.copyright')}</p>
      <p>{t('footer.tagline')}</p>
    </div>
  </div>
</footer>
