---
import { getCollection, render } from 'astro:content';
import SectionHeading from './ui/SectionHeading.astro';
import { formatDate, getLangFromUrl, isLang, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const races = await Promise.all(
  (await getCollection('calendario', isLang(lang)))
    .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
    .slice(0, 10)
    .map(async (race) => ({ ...race.data, Content: (await render(race)).Content })),
);
---

<section id="calendario" class="py-24 bg-white relative">
  <div class="max-w-4xl mx-auto px-5 sm:px-6 lg:px-8">

    <SectionHeading label={t('calendar.label')} title={t('calendar.title')} class="mb-16">
      <p class="text-slate-500 mt-6 text-base">{t('calendar.subtitle')}</p>
    </SectionHeading>

    <div class="space-y-4">
      {races.map(({ title, date, location, distance, url, Content }, index) => (
        <div class="group relative bg-white border-2 border-slate-100 rounded-2xl overflow-hidden hover:border-red-500 hover:shadow-xl transition-all duration-300 flex flex-col md:flex-row">
          {/* Race number + date block, bib style */}
          <time datetime={date.toISOString()} class="flex-shrink-0 flex flex-row md:flex-col items-center justify-center bg-red-500 group-hover:bg-red-600 transition-colors text-white px-6 py-4 md:py-6 md:min-w-[110px] gap-4 md:gap-1">
            <span class="font-display font-black text-xs uppercase tracking-widest text-red-200 hidden md:block">#{String(index + 1).padStart(2, '0')}</span>
            <span class="font-display font-black text-4xl md:text-5xl leading-none">{formatDate(lang, date, { day: '2-digit' })}</span>
            <span class="font-display font-bold text-sm md:text-base tracking-widest text-red-200 uppercase">{formatDate(lang, date, { month: 'short' })}</span>
          </time>

          <div class="flex-grow p-5 md:p-6 flex flex-col justify-center">
            <h3 class="font-display font-black uppercase tracking-wide text-xl md:text-2xl text-slate-800 group-hover:text-red-600 transition-colors leading-tight mb-2">
              {url ? <a href={url} target="_blank" rel="noopener noreferrer">{title}</a> : title}
            </h3>

            <div class="flex flex-wrap items-center gap-x-4 gap-y-1.5 text-sm text-slate-500 font-medium mb-2">
              <div class="flex items-center gap-1.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-500 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                {location}
              </div>
              <div class="flex items-center gap-1.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-red-400 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"></path><line x1="4" x2="4" y1="22" y2="15"></line></svg>
                <span class="font-bold text-slate-700">{distance}</span>
              </div>
            </div>

            <div class="text-sm leading-relaxed text-slate-600">
              <Content />
            </div>
          </div>

          {url && (
            <div class="flex-shrink-0 flex items-center justify-center px-5 py-4 md:py-0 border-t md:border-t-0 md:border-l border-slate-100 group-hover:border-red-100 transition-colors">
              <a href={url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-slate-50 hover:bg-red-500 text-slate-600 hover:text-white font-display font-bold uppercase tracking-wide text-sm transition-all duration-200">
                Info
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h6"></path><path d="m21 3-9 9"></path><path d="M15 3h6v6"></path></svg>
              </a>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
