---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { defaultLang, languages, type Lang } from '../i18n/ui';
import { getHomeUrl, getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
	title: string;
	description?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { title, description = t('layout.description') } = Astro.props;

const langs = Object.keys(languages) as Lang[];
const homeUrls = Object.fromEntries(langs.map((l) => [l, getHomeUrl(l)]));
const absolute = (path: string) => new URL(path, Astro.site).href;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<script is:inline define:vars={{ homeUrls }}>
			// On the first visit to `/`, redirect to the browser's language and remember it.
			// Visiting a language URL directly (e.g. a shared /fr/ link) counts as an explicit choice.
			try {
				var STORAGE_KEY = 'cct-lang-pref';
				var pathname = location.pathname;
				var pathLang = pathname === '/' ? 'es' : pathname.split('/')[1];

				if (pathLang in homeUrls && !localStorage.getItem(STORAGE_KEY)) {
					var detected = pathLang;
					if (pathname === '/') {
						var prefixes = { es: 'es', ca: 'ca', va: 'ca', fr: 'fr', en: 'en' };
						var navLangs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || 'en'];
						detected = 'en';
						for (var i = 0; i < navLangs.length; i++) {
							var match = prefixes[(navLangs[i] || '').slice(0, 2).toLowerCase()];
							if (match) { detected = match; break; }
						}
					}
					localStorage.setItem(STORAGE_KEY, detected);
					if (detected !== pathLang) location.replace(homeUrls[detected] + location.search + location.hash);
				}
			} catch (e) {}
		</script>
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | C.C. Tospelat</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={absolute(getHomeUrl(lang))} />
		{langs.map((l) => <link rel="alternate" hreflang={l} href={absolute(getHomeUrl(l))} />)}
		<link rel="alternate" hreflang="x-default" href={absolute(getHomeUrl(defaultLang))} />
		<link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
		<link rel="sitemap" href="/sitemap.xml" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="C.C. Tospelat" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={absolute(getHomeUrl(lang))} />
		<meta property="og:locale" content={languages[lang].locale.replace('-', '_')} />
		<slot name="head" />
		<Font cssVariable="--font-inter" preload={[{ weight: 400 }]} />
		<Font cssVariable="--font-barlow" preload={[{ weight: 900 }]} />
	</head>
	<body class="flex flex-col min-h-screen bg-slate-50">
		<slot />
	</body>
</html>
