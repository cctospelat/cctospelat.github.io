---
import '../styles/global.css';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface Props {
	title: string;
	description?: string;
}

const { title, description = t('layout.description') } = Astro.props;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<script is:inline>
			(function () {
				try {
					var STORAGE_KEY = 'cct-lang-pref';
					var langMap = { es: '/', ca: '/ca/', en: '/en/', fr: '/fr/' };
					var pathname = window.location.pathname;
					var pathLang = pathname === '/' ? 'es' : pathname.split('/')[1];

					if (!(pathLang in langMap)) return;
					if (localStorage.getItem(STORAGE_KEY)) return;

					// Visiting a language URL directly (e.g. a shared /fr/ link) is an
					// explicit choice: remember it, don't override with the browser language.
					if (pathname !== '/') {
						localStorage.setItem(STORAGE_KEY, pathLang);
						return;
					}

					var navLangs = navigator.languages && navigator.languages.length
						? navigator.languages
						: [navigator.language || 'en'];

					function detect() {
						for (var i = 0; i < navLangs.length; i++) {
							var l = (navLangs[i] || '').toLowerCase();
							if (l.indexOf('es') === 0) return 'es';
							if (l.indexOf('ca') === 0 || l.indexOf('va') === 0) return 'ca';
							if (l.indexOf('fr') === 0) return 'fr';
							if (l.indexOf('en') === 0) return 'en';
						}
						return 'en';
					}

					var detected = detect();
					localStorage.setItem(STORAGE_KEY, detected);
					if (detected !== 'es') {
						window.location.replace(langMap[detected] + window.location.search + window.location.hash);
					}
				} catch (e) {}
			})();
		</script>
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | C.C. Tospelat</title>
		<meta name="description" content={description} />
	</head>
	<body class="flex flex-col min-h-screen bg-slate-50">
		<slot />
	</body>
</html>

